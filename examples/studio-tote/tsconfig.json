{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@codesign-webmcp/core": ["../../packages/codesign-webmcp/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
