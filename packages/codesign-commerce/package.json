{
  "name": "@codesign-commerce/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:module && npm run build:browser",
    "build:module": "tsc -p tsconfig.build.json",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=CoDesignCommerce --platform=browser --target=chrome149 --sourcemap --outfile=dist/browser/codesign-commerce.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
