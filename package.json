{
  "name": "codesign-commerce-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify:browser-bundle": "node scripts/verify-browser-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p packages/codesign-commerce/tsconfig.test.json",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:evals": "node scripts/validate-eval-corpus.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
